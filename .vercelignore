# Ignore entire provider directory and duplicate projects
provider
provider/**
provider/*

# Ignore all zip files and archives
mahasolve.zip
*.zip
**/*.zip

# Ignore all node_modules everywhere
node_modules
node_modules/**
**/node_modules/**
mahasolve/node_modules/**

# Ignore dev-only vendor dependencies & heavy binaries to keep lambda bundle lightweight (<15MB)
mahasolve/vendor/laravel/pint/**
mahasolve/vendor/fakerphp/**
mahasolve/vendor/phpunit/**
mahasolve/vendor/mockery/**
mahasolve/vendor/psy/**
mahasolve/vendor/phar-io/**
mahasolve/vendor/sebastian/**
mahasolve/vendor/theseer/**
mahasolve/vendor/myclabs/**

# Ignore dev logs, cache, tests, git
*.log
**/*.log
mahasolve/storage/logs/**
mahasolve/storage/framework/cache/**
mahasolve/storage/framework/sessions/**
mahasolve/storage/framework/views/**
mahasolve/tests/**
.git/**
.github/**
