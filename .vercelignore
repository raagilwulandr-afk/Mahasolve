# Ignore duplicate provider directory
provider
provider/**
provider/*

# Ignore archives
mahasolve.zip
*.zip
**/*.zip

# Ignore node_modules (only needed for frontend build step, not PHP lambda runtime)
node_modules
node_modules/**
**/node_modules/**
mahasolve/node_modules/**

# Ignore heavy dev-only standalone binary (15.8MB)
mahasolve/vendor/laravel/pint/**

# Ignore logs, cache, tests, git
*.log
**/*.log
mahasolve/storage/logs/**
mahasolve/storage/framework/cache/**
mahasolve/storage/framework/sessions/**
mahasolve/storage/framework/views/**
mahasolve/tests/**
.git/**
.github/**
